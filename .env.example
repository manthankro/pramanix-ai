# --- AI providers -----------------------------------------------------------
# The server uses Groq first (very fast) and automatically falls back to Gemini
# if Groq errors or is rate limited. Set at least one of the two keys.

# Groq: https://console.groq.com  (free tier, rate limited per organisation)
GROQ_API_KEY=""
# Check the exact model ID on https://console.groq.com/docs/models
GROQ_MODEL="openai/gpt-oss-120b"

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# --- GitHub -----------------------------------------------------------------
# Strongly recommended for live demos: raises the GitHub API limit from
# 60 requests/hour to 5,000 requests/hour. A token with NO scopes is enough
# (public data only): https://github.com/settings/tokens
GITHUB_TOKEN=""

# --- Server -----------------------------------------------------------------
PORT=3000
# Set to "production" on your host (the `npm start` script also enables it).
NODE_ENV=development
# Max AI requests per minute per client IP. Keep generous: everyone on the same
# college Wi-Fi can share one public IP.
RATE_LIMIT_PER_MIN=60
# Repository shown by default in the GitHub Mentor module.
DEFAULT_REPO="manthankro/pramanix-ai-"
